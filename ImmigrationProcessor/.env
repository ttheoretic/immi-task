# ---------------------------------------------------------------------------
# Immigration Document Processor - environment configuration
# Copy real values in here. NEVER commit real keys to version control.
# The app runs without any credentials at all: the deterministic rule engine
# is the first stage and needs no model. An LLM (local Ollama or Azure) is
# only asked about documents the rules could not resolve.
# ---------------------------------------------------------------------------

# --- Which LLM backs up the rule engine ------------------------------------
# The deterministic rule engine always runs FIRST. Only documents it cannot
# resolve on its own are handed to the model named here.
#   auto   - prefer a reachable local Ollama, else Azure OpenAI, else nothing
#   ollama - local model only (no data leaves the machine)
#   azure  - Azure OpenAI only
#   none   - rules only; everything unresolved goes to data/review
LLM_PROVIDER=auto
# Set to false to let the model analyse every document first (old behaviour).
RULES_FIRST=true

# --- Ollama (local LLM, no API key, no data leaving the machine) ------------
# Install from https://ollama.com, then: ollama pull qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TEMPERATURE=0.0
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=8192

# --- Azure OpenAI (classification + field extraction) ----------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TEMPERATURE=0.0
AZURE_OPENAI_MAX_TOKENS=2000
AZURE_OPENAI_TIMEOUT_SECONDS=90

# --- Azure AI Document Intelligence (OCR for scanned PDFs) -----------------
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=
DOCUMENT_INTELLIGENCE_MODEL=prebuilt-read

# --- Business rules --------------------------------------------------------
# Documents below this confidence are parked in data/review (REVIEW REQUIRED).
CONFIDENCE_THRESHOLD=0.90
# Weak rule matches (keyword evidence only) can never exceed this confidence.
HEURISTIC_CONFIDENCE_CAP=0.55
# Confidence granted when every field of the file name came from a labelled
# anchor. A checksum-verified passport MRZ scores 0.95 instead.
RULE_TRUSTED_CONFIDENCE=0.92
# A page with fewer characters than this is treated as scanned and sent to OCR.
OCR_MIN_CHARS_PER_PAGE=60
# Rejected upload size in MB.
MAX_UPLOAD_MB=50
# Where the client folders live (relative paths are resolved from the app root).
CLIENTS_ROOT=data/processed/Clients
# Placeholder used in file names when a field could not be extracted.
UNKNOWN_TOKEN=UNKNOWN

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
