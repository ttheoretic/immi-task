# ---------------------------------------------------------------------------
# Immigration Document Processor - environment configuration
# Copy real values in here. NEVER commit real keys to version control.
# The app also runs without Azure credentials (keyword/regex fallback, every
# document is then routed to data/review).
# ---------------------------------------------------------------------------

# --- Azure OpenAI (classification + field extraction) ----------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TEMPERATURE=0.0
AZURE_OPENAI_MAX_TOKENS=2000
AZURE_OPENAI_TIMEOUT_SECONDS=90

# --- Azure AI Document Intelligence (OCR for scanned PDFs) -----------------
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=
DOCUMENT_INTELLIGENCE_MODEL=prebuilt-read

# --- Business rules --------------------------------------------------------
# Documents below this confidence are parked in data/review (REVIEW REQUIRED).
CONFIDENCE_THRESHOLD=0.90
# Results produced without AI can never exceed this confidence.
HEURISTIC_CONFIDENCE_CAP=0.55
# A page with fewer characters than this is treated as scanned and sent to OCR.
OCR_MIN_CHARS_PER_PAGE=60
# Rejected upload size in MB.
MAX_UPLOAD_MB=50
# Where the client folders live (relative paths are resolved from the app root).
CLIENTS_ROOT=data/processed/Clients
# Placeholder used in file names when a field could not be extracted.
UNKNOWN_TOKEN=UNKNOWN

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
